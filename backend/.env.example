# Backend
SECRET_KEY=degistir-bunu-rastgele-uzun-bir-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DEBUG=true

DATABASE_URL=sqlite:///./kalori.db
MONGODB_URI=#
MONGODB_DB_NAME=kalori

# Dış servisler
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
GROQ_API_KEY=#gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

PANTRY_CONFIDENCE_DAYS=7
PANTRY_UNKNOWN_WEIGHT=0.4

# W4-T15: dayaniklilik testi icin. 'broken' = her cagri hata verir,
# uygulama kural tabanli dususe gecmeli (COKMEMELI).
VISION_PROVIDER=fake   # fake | groq | openai | broken
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=20
VISION_MAX_RETRIES=2
VISION_MAX_IMAGE_PX=1600
VISION_JPEG_QUALITY=80
VISION_DAILY_LIMIT_PER_USER=30

CHAT_PROVIDER=fake     # fake | groq | broken

# ---------- W4-T15 Dayaniklilik ----------
# Kac ardisik hatadan sonra saglayiciya HIC gidilmesin (devre acilir).
CIRCUIT_FAILURE_THRESHOLD=3
# Devre acik kaldiktan sonra tek deneme cagrisina izin verilene kadar gecen sure.
CIRCUIT_OPEN_SECONDS=60
# Gorme/LLM coktugunde 502 yerine kural tabanli dususe gecilsin mi.
# false = eski davranis (hata firlat). ACIL GERI ALMA anahtari: sahada
# dusus beklenmedik bir sorun cikarirsa kod degistirmeden kapatilabilir.
DEGRADE_ON_PROVIDER_FAILURE=true